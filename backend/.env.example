# Copy to backend/.env for local runs. On Railway, set these as service variables instead.

# ---------- Required ----------
# Railway: ${{pgvector.DATABASE_URL}} (any postgres:// URL works)
DATABASE_URL=postgresql+psycopg://sitebot:sitebot@localhost:5433/sitebot
# Long random string; signs login cookies and email codes
SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated emails that are always admins
ADMIN_EMAILS=you@example.com
OPENROUTER_API_KEY=
# Google sign-in (OAuth client ID)
GOOGLE_CLIENT_ID=
# true on Railway (https)
COOKIE_SECURE=false

# ---------- Email for sign-up codes (set one option) ----------
# Option A: Resend (recommended; sends over HTTPS)
RESEND_API_KEY=
# Option B: SMTP, e.g. Gmail with an app password (smtp.gmail.com, port 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender on the code emails. With Resend it must use a domain you verified there.
MAIL_FROM=SiteBot <no-reply@example.com>

# ---------- Optional (defaults shown) ----------
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_FAST_MODEL=anthropic/claude-haiku-5.5
VERIFY_ANSWERS=true
GLOBAL_BUDGET_USD=10
DEFAULT_USER_LIMIT_USD=1
MAX_PAGES=5000
MAX_DEPTH=8
LARGE_SITE_PAGES=300
MIN_SIMILARITY=0.55
ENABLE_PLAYWRIGHT=true
# Website embeds: default daily spend limit per embed (admins can change it per embed)
EMBED_DAILY_CAP_USD=0.5
# Local testing only (never on Railway): extra origins every embed may run on, e.g. http://localhost:5500
EMBED_DEV_ORIGINS=
# Public address of the app, for links in notification emails (e.g. https://<your-app>.up.railway.app)
APP_URL=
# Encrypts AI provider API keys added in Admin console > AI providers. Set it before adding keys (any long random
# string). Without it, a key derived from SECRET_KEY is used, so changing SECRET_KEY would make saved keys unreadable.
PROVIDER_KEYS_SECRET=
# Error monitoring (optional): server and browser DSNs from sentry.io
SENTRY_DSN=
SENTRY_BROWSER_DSN=
